{
  "seed": 42,
  "output_dir": "./protein_geometry_project",
  "cache_dir": "./protein_geometry_project/data/raw_pdb",
  "device": "cpu",
  "smoke_test": true,
  "dataset_limit": 8,
  "minimum_chain_length": 50,
  "maximum_chain_length": 150,
  "minimum_loop_length": 5,
  "maximum_loop_length": 15,
  "resolution_cutoff": 2.5,
  "train_fraction": 0.7,
  "validation_fraction": 0.15,
  "test_fraction": 0.15,
  "hidden_dim": 64,
  "num_layers": 3,
  "num_rbf": 16,
  "cutoff_radius": 12.0,
  "k_neighbors": 16,
  "k_seq_neighbors": 4,
  "batch_size": 2,
  "gradient_accumulation_steps": 2,
  "learning_rate": 0.0005,
  "weight_decay": 0.0001,
  "max_steps": 40,
  "clip_grad_norm": 1.0,
  "checkpoint_interval": 20,
  "evaluation_interval": 20,
  "diffusion_steps": 50,
  "sampling_steps": 15,
  "beta_schedule": "linear",
  "beta_start": 0.001,
  "beta_end": 0.03,
  "num_samples": 4,
  "geometry_loss_weights": {
    "mse": 1.0,
    "bond": 0.25,
    "anchor": 0.5,
    "clash": 0.15
  },
  "enable_pretrained": false,
  "enable_sequence_design": false,
  "enable_refolding": false,
  "enable_openmm": false
}